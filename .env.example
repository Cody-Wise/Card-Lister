PORT=3000
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_USER_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_REDIRECT_HOST=
EBAY_REFRESH_TOKEN=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_CATEGORY_ID=261328
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_GROUND_ADVANTAGE_ID=
EBAY_FULFILLMENT_POLICY_LESS_THAN_20_ID=
EBAY_FULFILLMENT_POLICY_LESS_THAN_20_MACHINEABLE_ID=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
# Experimental: set OCR_PROVIDER=ximilar to use Ximilar's card-database lookup
# (https://api.ximilar.com/collectibles/v2/sport_id) instead of OpenAI vision
# for card identification. Requires XIMILAR_API_TOKEN. Off by default.
OCR_PROVIDER=
# XIMILAR_API_TOKEN is also used by the Grading tab's AI grade-estimation
# feature (src/services/ximilar-grading.js) — Ximilar's card-grader product
# is billed separately from the sport_id/tcg_id identification calls above.
XIMILAR_API_TOKEN=
XIMILAR_TIMEOUT_MS=30000
# Optional override for how long the Grading tab's background poll loop
# waits for a submitted card-grader job before giving up (ms).
XIMILAR_GRADING_POLL_TIMEOUT_MS=120000
# The Grading tab (AI grade-estimation queue + send/return-from-grading) is
# disabled by default as of 2026-07-04 — Ximilar's results weren't reliable
# enough. Code is intentionally left in place, not deleted, in case a
# different provider gets swapped in later. Set to true to turn it back on.
GRADING_FEATURE_ENABLED=
# Powers BOTH per-card sold-comp lookups and the market-heat feature (see
# src/services/apify.js) — SoldComps.com is no longer used (its match quality
# had degraded on most cards; the Apify actor's historical accuracy was
# better). Unlike a flat monthly request quota, Apify bills per real actor
# run, so watch APIFY_BUDGET_SAFETY_MARGIN_USD below.
APIFY_TOKEN=
APIFY_EBAY_SOLD_ACTOR_ID=caffein.dev~ebay-sold-listings
APIFY_EBAY_SOLD_DAYS_TO_SCRAPE=60
APIFY_EBAY_SOLD_COUNT=15
APIFY_EBAY_SITE=ebay.com
APIFY_EBAY_CATEGORY_ID=0
APIFY_EBAY_SORT_ORDER=endedRecently
APIFY_EBAY_ITEM_LOCATION=domestic
# Refuses new per-card lookups once the account's real monthly usage (per
# Apify's own /v2/users/me/limits) is within this many dollars of its cap —
# added after Market Heat alone blew through a $29/month cap with no warning
# on 2026-07-03. Raise if you have more real headroom to work with.
APIFY_BUDGET_SAFETY_MARGIN_USD=1
# How long to wait before retrying a per-card comp lookup that already came
# back with zero comps (vs the normal 15-minute cooldown for a lookup that
# hasn't been tried yet). Without this, a card whose search genuinely finds
# nothing never satisfies the "already has a fresh price" skip, so only the
# 15-minute cooldown stood between it and a re-billed Apify run — a fixed
# pool of ~15-20 genuinely comp-less cards re-fired real runs on every
# hydration trigger (hourly-ish) for days before this was caught on
# 2026-07-11. Default 1440 (24h).
APIFY_NO_COMPS_COOLDOWN_MINUTES=1440
SOLD_COMPS_APIFY_TIMEOUT_MS=20000
# Playwright scraper for eBay's PUBLIC sold-listings search (no login).
# Same normalization/gating as the Apify path (parseApifySoldListings), so
# the comp quality bar would be identical IF it worked.
#
# OFF by default — it does not currently work. Confirmed live 2026-07-26,
# every route blocked:
#   datacenter IP  -> /splashui/captcha, "Security Measure | eBay"
#   DataImpulse    -> "Error Page | eBay" / "Something went wrong on our end"
#   both           -> can redirect to signin.ebay.com
# Two different residential exits behaved identically, so eBay is keying on
# the automated-browser fingerprint, not the IP. Set to 1 only after adding
# something that changes that (stealth fingerprinting, or CapSolver against
# the captcha the datacenter path serves).
EBAY_SOLD_SCRAPER=0
EBAY_SCRAPER_PROXY_SERVER=
EBAY_SCRAPER_PROXY_USERNAME=
EBAY_SCRAPER_PROXY_PASSWORD=
# Sold-comp provider: "off" (code default), "soldcomps", "apify", "scraper".
# PRODUCTION RUNS "soldcomps" as of 2026-07-30 — api.sold-comps.com, a direct
# eBay-sold-listings API. It reaches the same data as the Apify actor and
# returns the SAME item schema, but bills a FLAT MONTHLY REQUEST QUOTA rather
# than per run ($0.0001-$2+ each; Market Heat alone once blew a $29/mo cap).
# Sold comps are the comp engine when enabled: calculatePrice() leads on sold
# P25/median and only blends active listings when the market is hot.
# The code default stays "off" so no deployment starts spending by accident.
# "scraper" remains unusable — eBay gates sold listings behind sign-in for a
# plain browser (controlled test in ebay-sold-scraper.js).
SOLD_COMPS_PROVIDER=soldcomps
SOLDCOMPS_API_KEY=
# The account is on the FREE tier: 100 requests/month. Set this to the PLAN's
# real quota — the app counts locally and refuses new requests at the limit,
# so it fails with a clear message instead of taking 403s for the rest of the
# billing cycle.
SOLDCOMPS_MONTHLY_REQUEST_LIMIT=100
# Retries ONLY when the scrape itself came back empty (SoldComps is a live
# scrape; the same keyword genuinely returns 0 items on a fraction of calls).
# Worst case per card lookup is keywords x attempts, so at 2 x 3 a single card
# could cost 6% of a 100/month quota — hence 2 while on the free plan.
SOLDCOMPS_MAX_ATTEMPTS=2

# --- Active-listing pricing (src/services/active-listing-pricing.js) ---
# The FALLBACK path, used when SOLD_COMPS_PROVIDER is off or a card has too
# few relevant sold comps. eBay gates sold/completed listings behind sign-in
# for a plain browser (controlled test 2026-07-26: identical session, plain
# search = 62 rows, same search +LH_Sold = sign-in wall), so active listings
# were the only open signal for a while. Since 2026-07-30 the Apify actor
# reaches completed sales again and leads pricing when available.
#
# Ceiling for UNATTENDED auto-repricing from active listings. Active
# listings are ASKS, not sales, so the scheduler only acts on cards priced
# below this, where a wrong price is cheap. At/above it a card still gets a
# priced suggestion, but a human approves it. 0 disables unattended
# active-listing repricing entirely.
AUTO_ACTIVE_PRICING_MAX_PRICE=10
# How many relevant sold comps it takes before the manual filename price
# stops clamping the computed price. The filename read was a STAND-IN while
# sold data was unreachable; past this bar the real sales lead and the human
# read is kept as evidence only. Defaults to 3, matching the bar
# calculatePrice uses to call sold evidence "high confidence".
MANUAL_ANCHOR_SOLD_COMP_MIN=3
# Where in the matched price distribution to anchor. Unsold asks skew high,
# so this defaults low (P25) rather than the median.
ACTIVE_PRICING_PERCENTILE=0.25
# Scarcity curve for print-run tier mismatches. Value scales SUB-linearly
# with rarity: at 0.4, a /25 priced off /50 listings takes a ~32% premium
# (not 100%), and off /10 listings takes a ~31% discount.
ACTIVE_PRICING_SCARCITY_EXPONENT=0.4
# Hard clamps on that adjustment, so one thin cross-tier comparison can't
# produce an absurd multiplier.
ACTIVE_PRICING_MIN_FACTOR=0.5
ACTIVE_PRICING_MAX_FACTOR=2.0
EBAY_BROWSE_ACTIVE_COUNT=15
EBAY_BROWSE_SOLD_COUNT=15
MARKET_HEAT_DEFAULT_LIMIT=50
# Market Heat refreshes at most once per this interval (default 7 days) no
# matter how many times the page is visited or "Refresh" is clicked — that
# loophole (refresh bypassing the cache entirely) is what let repeated clicks
# burn through the Apify budget above in a single afternoon.
MARKET_HEAT_REFRESH_MS=2592000000
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
DRIVE_FOLDER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
SESSION_SECRET=change-me-to-a-random-string
SURYA_OCR_BIN=
SURYA_OCR_TIMEOUT_MS=60000
# Background schedulers (see src/server.js) — each is off by default; set to
# a positive number of minutes to enable.
SALES_SYNC_INTERVAL_MINUTES=
REPRICE_INTERVAL_MINUTES=
# Scheduled Best Offers scan: checks every active listing for new
# buyer-submitted Best Offers and records recently-resolved ones (including
# offers the auto-accept/decline thresholds handled). Off when blank; 360
# is the current recommendation — offers carry a ~48-hour response clock, and
# each scan spends real Trading API budget (one GetBestOffers per active
# listing plus a GetMyeBaySelling page sweep, ~5 pages at 850 listings).
# Confirmed live 2026-07-10 that a 30-minute cadence exhausts this app's
# GetMyeBaySelling daily limit on top of normal dashboard use; confirmed
# again 2026-07-11 that even 120 minutes wasn't enough once combined with
# Listings-tab loads and bulk-reprice previews (which hit the same eBay
# call) — raised to 360 to match the reprice scheduler's own cadence.
BEST_OFFERS_SCAN_INTERVAL_MINUTES=
# Where to push user-facing notifications (currently: new pending Best
# Offers). An ntfy topic URL (https://ntfy.sh/your-topic — free, no signup,
# phone app available) or a Discord webhook URL both work; anything else is
# POSTed the message as plain text. Off when blank.
PUSH_NOTIFY_URL=
# Hard safety rails on the scheduled repricer specifically (no human review
# before the price push, unlike the manual reprice button) — a comp-derived
# target is clamped to [current price * MIN_FACTOR, current price *
# MAX_FACTOR] before being pushed to eBay. Defaults to 0.8/1.2 (+/-20%) if unset.
REPRICE_MIN_FACTOR=
REPRICE_MAX_FACTOR=
# Best Offer auto-accept/auto-decline thresholds, set on every fixed-price
# listing as a percentage of its own asking price (recomputed whenever the
# price changes, including scheduled reprices). Defaults if unset: accept at
# 85% of asking for listings up to $50 and 90% above $50 (the tier boundary
# itself is configurable), decline at 50% everywhere. Percentages are
# decimals in (0, 1].
BEST_OFFER_AUTO_ACCEPT_PCT=
BEST_OFFER_AUTO_ACCEPT_PCT_HIGH_TIER=
BEST_OFFER_AUTO_ACCEPT_HIGH_TIER_THRESHOLD=
BEST_OFFER_AUTO_DECLINE_PCT=
DATA_HEALTH_CHECK_INTERVAL_MINUTES=
DACARDWORLD_WATCH_INTERVAL_MINUTES=1440
# Optional: report each scheduler's outcome to an Uptime Kuma "Push" monitor
# so a scheduler that stops firing (or starts always failing) shows up as an
# alert instead of only living in `docker logs`. In Uptime Kuma, add a
# monitor per scheduler with Monitor Type = Push, set its heartbeat interval
# to roughly 2x the scheduler's own interval above (so a single missed run
# doesn't false-alarm), then paste the generated push URL here. Leave blank
# to skip — pinging is a no-op with no push URL configured.
UPTIME_KUMA_PUSH_URL_SALES_SYNC=
UPTIME_KUMA_PUSH_URL_REPRICE=
UPTIME_KUMA_PUSH_URL_DATA_HEALTH_CHECK=
UPTIME_KUMA_PUSH_URL_DACARDWORLD=
UPTIME_KUMA_PUSH_URL_BEST_OFFERS=

# DA Card World watcher (src/services/dacardworld.js) — daily snapshot of
# current new releases and sales/deals from dacardworld.com. That site sits
# behind a Cloudflare JS challenge on every page (confirmed directly: plain
# fetch()/curl gets a challenge page, not real content), so this runs a
# real headless browser (Playwright) with CapSolver's official browser
# extension (github.com/capsolver/capsolver-browser-extension) loaded to
# auto-solve the challenge. Requires an existing CapSolver subscription.
CAPSOLVER_API_KEY=
# Only needed if the extension isn't at the default path the Dockerfile
# bakes it into (/app/capsolver-extension).
CAPSOLVER_EXTENSION_DIR=
# How long a page navigation is allowed to take, and how long to wait after
# that for Cloudflare's challenge (and CapSolver solving it) to settle
# before reading page content.
DACARDWORLD_NAVIGATION_TIMEOUT_MS=45000
DACARDWORLD_CHALLENGE_SETTLE_MS=12000
# Minimum time between real refreshes, regardless of how often the manual
# "Refresh now" button is clicked — this is the same lesson learned the
# hard way with Market Heat (see MARKET_HEAT_REFRESH_MS above): a refresh
# button with no floor can launch a new browser run on every click.
DACARDWORLD_MIN_REFRESH_MINUTES=60
# Optional residential/mobile proxy — this server's datacenter IP was
# confirmed tripping a Cloudflare Private Access Token challenge (hardware
# device attestation, not solvable via CapSolver) even with the extension
# working correctly. Falls through to no proxy if DACARDWORLD_PROXY_SERVER
# is blank. Format: server is a full URL like http://gw.example.com:823.
DACARDWORLD_PROXY_SERVER=
DACARDWORLD_PROXY_USERNAME=
DACARDWORLD_PROXY_PASSWORD=

# How far above the manual filename price the live market may push a card.
# The scanner-typed price anchors valuation (sold comps are unavailable, so
# the computed price comes from other sellers ASKS), but a card can
# genuinely heat up after it was scanned. 2 = may list at up to double the
# manual read; 1 pins the price to the manual value exactly.
MANUAL_ANCHOR_MAX_MULTIPLE=2
