PORT=3000
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_USER_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_REDIRECT_HOST=
EBAY_REFRESH_TOKEN=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_CATEGORY_ID=261328
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_GROUND_ADVANTAGE_ID=
EBAY_FULFILLMENT_POLICY_LESS_THAN_20_ID=
EBAY_FULFILLMENT_POLICY_LESS_THAN_20_MACHINEABLE_ID=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
# Experimental: set OCR_PROVIDER=ximilar to use Ximilar's card-database lookup
# (https://api.ximilar.com/collectibles/v2/sport_id) instead of OpenAI vision
# for card identification. Requires XIMILAR_API_TOKEN. Off by default.
OCR_PROVIDER=
XIMILAR_API_TOKEN=
XIMILAR_TIMEOUT_MS=30000
APIFY_TOKEN=
APIFY_EBAY_SOLD_ACTOR_ID=caffein.dev~ebay-sold-listings
APIFY_EBAY_SOLD_DAYS_TO_SCRAPE=60
APIFY_EBAY_SOLD_COUNT=10
APIFY_EBAY_SITE=ebay.com
APIFY_EBAY_CATEGORY_ID=0
APIFY_EBAY_SORT_ORDER=endedRecently
APIFY_EBAY_ITEM_LOCATION=domestic
EBAY_BROWSE_ACTIVE_COUNT=50
CARDHEDGE_API_KEY=
CARDHEDGE_API_BASE_URL=https://api.cardhedger.com
CARDHEDGE_COMPS_COUNT=50
CARDHEDGE_HEAT_PAGES=5
CARDHEDGE_MIN_INTERVAL_MS=6500
CARDHEDGE_MAX_RETRIES=2
CARDHEDGE_USE_APIFY_FALLBACK=false
MARKET_HEAT_DEFAULT_LIMIT=50
MARKET_HEAT_REFRESH_MS=604800000
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
DRIVE_FOLDER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
SESSION_SECRET=change-me-to-a-random-string
SURYA_OCR_BIN=
SURYA_OCR_TIMEOUT_MS=60000
# Background schedulers (see src/server.js) — each is off by default; set to
# a positive number of minutes to enable.
SALES_SYNC_INTERVAL_MINUTES=
REPRICE_INTERVAL_MINUTES=
DATA_HEALTH_CHECK_INTERVAL_MINUTES=
# Optional: report each scheduler's outcome to an Uptime Kuma "Push" monitor
# so a scheduler that stops firing (or starts always failing) shows up as an
# alert instead of only living in `docker logs`. In Uptime Kuma, add a
# monitor per scheduler with Monitor Type = Push, set its heartbeat interval
# to roughly 2x the scheduler's own interval above (so a single missed run
# doesn't false-alarm), then paste the generated push URL here. Leave blank
# to skip — pinging is a no-op with no push URL configured.
UPTIME_KUMA_PUSH_URL_SALES_SYNC=
UPTIME_KUMA_PUSH_URL_REPRICE=
UPTIME_KUMA_PUSH_URL_DATA_HEALTH_CHECK=
